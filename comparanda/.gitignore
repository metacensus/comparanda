# Data files (large PDFs and spreadsheets)
/data/

# Source data archive

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# macOS
.DS_Store

# Provenance hook runtime state (per-session attempt counters).
.claude/hooks/.state/

# Provenance hook failure markers (per-paper, written when validator gives up).
# These are runtime signals consumed by the orchestrator/harness; the persistent
# record is the observation log.
projects/*/extractions/*.provenance-failed.json

# Runtime caches
# NOTE: .rag_cache/ is NOT gitignored — it costs money to rebuild (OpenAI API).
# Preserve it across branches and worktrees.

# v1 runtime output (kept for reference during migration)
/surveys/
/extractions/
/normalization/
/iterations/iter_*/
/iterations/run_log.txt
/iterations/frozen_subset.json
/iterations/lessons.json
/iterations/trajectory.json
/iterations/versions/

# Per-domain application data — populated only in domain forks (not canonical).
# Use /projects/* (not /projects/) so forks can re-include a specific domain via
# !/projects/<domain>/ on their `main` branch. Git refuses to re-include children
# of a fully-excluded directory, so the glob form is required for fork overrides.
# The fork's !-override never lands on `methodology`, so methodology PRs to
# canonical never carry domain-specific gitignore drift.
/projects/*
