# Data files (large PDFs and spreadsheets)
/data/

# Source data archive

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# macOS
.DS_Store

# Runtime caches
# NOTE: .rag_cache/ is NOT gitignored — it costs money to rebuild (OpenAI API).
# Preserve it across branches and worktrees.

# v1 runtime output (kept for reference during migration)
/surveys/
/extractions/
/normalization/
/iterations/iter_*/
/iterations/run_log.txt
/iterations/frozen_subset.json
/iterations/lessons.json
/iterations/trajectory.json
/iterations/versions/

# Per-domain application data — populated only in domain forks (not canonical).
# A fork un-ignores this on its `main` branch via a !/projects/<domain>/ override
# committed alongside the domain data. The override never lands on `methodology`,
# so methodology PRs to canonical never carry domain-specific gitignore drift.
/projects/
