# Data files (large PDFs and spreadsheets)
/data/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# macOS
.DS_Store

# Provenance hook runtime state (per-session attempt counters).
.claude/hooks/.state/

# Provenance hook failure markers (per-paper, written when validator gives up).
# These are runtime signals consumed by the orchestrator/harness; the persistent
# record is the observation log.
projects/*/extractions/*.provenance-failed.json
projects/*/extractions/.staging/

# Runtime caches
.rag_cache/

# Legacy in-repo runtime output locations (v1 layout)
/surveys/
/extractions/
/normalization/
/iterations/iter_*/
/iterations/run_log.txt
/iterations/frozen_subset.json
/iterations/lessons.json
/iterations/trajectory.json
/iterations/versions/

# Per-domain project data. This repository ships system code only; domain data
# normally lives in a separate project directory (see docs/domain-superproject.md).
# If you instead keep domain data in a fork of this repository, re-include it in
# your fork with a line such as `!/projects/<domain>/`. The pattern is
# `/projects/*` rather than `/projects/` because Git cannot re-include children
# of a fully excluded directory.
/projects/*
