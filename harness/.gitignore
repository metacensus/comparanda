__pycache__/
*.pyc
.venv/
.DS_Store

# Per-domain harness runtime state — populated only in domain forks (not canonical).
# Use /iterations/* (not /iterations/) so forks can re-include via !/iterations/
# on `main`. Git refuses to re-include children of a fully-excluded directory.
# The fork's !-override never lands on `methodology`.
/iterations/*
