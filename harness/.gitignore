__pycache__/
*.pyc
.venv/
.DS_Store

# Harness run state (per-domain). Normally written to an external iterations
# directory (COMPARANDA_ITERATIONS_DIR). A fork that keeps run state in-repo can
# re-include it with `!/iterations/`; the pattern is `/iterations/*` rather than
# `/iterations/` because Git cannot re-include children of a fully excluded
# directory.
/iterations/*
