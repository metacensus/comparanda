{
  "permissions": {
    "additionalDirectories": ["../comparanda"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-comparanda.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
